diff --git a/dist/list-style.js b/dist/list-style.js
new file mode 100644
index 0000000000000000000000000000000000000000..964ffb76e42ac5d437ee4c67d81a5c841dbb80d1
--- /dev/null
+++ b/dist/list-style.js
@@ -0,0 +1,25 @@
+// Local MyST attrs_block subset: the five Python MyST ordered-list styles (#734).
+// Reuse markdown-it's existing list rule; do not parse list bodies ourselves.
+import listRule from 'markdown-it/lib/rules_block/list.js';
+const styles = 'decimal|lower-alpha|upper-alpha|lower-roman|upper-roman';
+const attribute = new RegExp(`^\\{style=(?:(${styles})|"(${styles})")\\}[\\t ]*$`);
+export function listStylePlugin(md) {
+  md.block.ruler.before('list', 'list_style', (state, start, end, silent) => {
+    if (state.sCount[start] - state.blkIndent >= 4) return false;
+    const line = state.src.slice(state.bMarks[start] + state.tShift[start], state.eMarks[start]);
+    const match = attribute.exec(line);
+    if (!match) return false;
+    let next = start + 1;
+    while (next < end && state.isEmpty(next)) next++;
+    if (next >= end || state.sCount[next] !== state.sCount[start]) return false;
+    const body = state.src.slice(state.bMarks[next] + state.tShift[next], state.eMarks[next]);
+    if (!/^\d{1,9}[.)](?:\s|$)/.test(body)) return false;
+    const index = state.tokens.length;
+    if (!listRule(state, next, end, silent)) return false;
+    if (!silent) {
+      state.tokens[index].attrSet('style', match[1] ?? match[2]);
+      state.tokens[index].map[0] = start;
+    }
+    return true;
+  }, {alt: ['paragraph', 'reference', 'blockquote']});
+}
